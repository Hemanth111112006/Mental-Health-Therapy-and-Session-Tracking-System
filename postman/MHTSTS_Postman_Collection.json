              "script": {
                "exec": [
                  "",
                  "pm.test(\"Status code is expected\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueId = Date.now();",
                  "pm.collectionVariables.set(\"test_username\", \"testuser_\" + uniqueId);",
                  "pm.collectionVariables.set(\"test_email\", \"test_\" + uniqueId + \"@example.com\");"
