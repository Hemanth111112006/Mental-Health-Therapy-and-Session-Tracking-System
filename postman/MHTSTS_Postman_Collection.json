{
  "info": {
    "_postman_id": "mhtsts-api-collection-2026",
    "name": "MHTSTS - Mental Health Therapy and Session Tracking System API",
    "description": "Complete Postman API Collection for MHTSTS Spring Boot Backend (Port 8080). Includes Auth, Role-Based Access Control (RBAC), Client Management, Appointments, Session Notes, Treatment Plans, Crisis Assessments, Safety Plans, and Reports.",
